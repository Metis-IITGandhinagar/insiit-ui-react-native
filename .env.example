# Copy this file to `.env` and fill in the blanks:  cp .env.example .env
#
# Expo loads `.env` automatically, but only EXPO_PUBLIC_* variables are exposed to the
# app — and they are INLINED INTO THE BUNDLE at build time, so anyone who unzips the APK
# can read them. Never put a real secret here; secrets belong on the backend.
#
# Values are baked in when the JS bundle is built, so restart with a cleared cache
# after editing:  npx expo start --clear
#
# Machine-specific overrides go in `.env.local`, which is gitignored.
# Startup validation lives in src/core/config/checkEnv.ts.

# --- Required ---------------------------------------------------------------------

# Base URL of the INSIIT backend (https://github.com/Metis-IITGandhinagar), no trailing slash.
EXPO_PUBLIC_API_BASE_URL=https://insiit-api-rust.metis-iitgn.tech

# Timetable scraper API. Include the /api prefix.
EXPO_PUBLIC_TIMETABLE_API_URL= https://timetable.metis-iitgn.tech/api

# Campus mess portal, scraped to fetch the meal QR code. Origin only, no trailing slash.
EXPO_PUBLIC_MESS_PORTAL_URL=http://mess.iitgn.ac.in

# Google Sign-In OAuth *web* client ID — the entry with "client_type": 3 in your
# google-services.json, or the "Web client (auto created by Google Service)" credential
# in the Google Cloud console. NOT the Android client ID: Firebase needs the web one to
# exchange the ID token. See README.md → Firebase setup.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Optional ---------------------------------------------------------------------

# Mapbox access token for the campus map. Leave blank to skip Mapbox setup — the map
# screen then renders a "Map unavailable" placeholder and the rest of the app works.
# Must be a PUBLIC token (starts with `pk.`) scoped to style/tile reads. A secret `sk.`
# token would be readable in the shipped APK and billable to your account.
EXPO_PUBLIC_MAPBOX_TOKEN=
