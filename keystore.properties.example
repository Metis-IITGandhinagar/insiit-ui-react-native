# Copy to `keystore.properties` (gitignored) and fill in the passwords.
#
# Gradle reads this file itself, from the repo root, at build time — there is no
# `source` / `set -a` step, so it works identically on macOS, Linux and Windows.
#
# Resolution order for each value, first hit wins:
#   1. a Gradle property  (-PINSIIT_… on the command line, or ~/.gradle/gradle.properties)
#   2. this file
#   3. ./upload-keystore.jks at the repo root, else the template debug.keystore
#
# So with the .jks sitting in the repo root you only need the three lines below.
# STORE_FILE is optional — omit it and the root ./upload-keystore.jks is used.

INSIIT_KEY_ALIAS=your-key-alias
INSIIT_STORE_PASSWORD=your-store-password
INSIIT_KEY_PASSWORD=your-key-password

# Optional — a path relative to the repo root (NOT android/app/) or an absolute path.
#INSIIT_STORE_FILE=upload-keystore.jks

# Optional — sign debug builds with a separate key. Omitted, debug is signed with the
# key above, so there is a single SHA-1 to register in Firebase.
#INSIIT_DEBUG_STORE_FILE=insiit-debug.keystore
#INSIIT_DEBUG_KEY_ALIAS=insiit-debug
#INSIIT_DEBUG_STORE_PASSWORD=android
#INSIIT_DEBUG_KEY_PASSWORD=android
